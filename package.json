{
  "name": "ecommerce-backend-nodejs",
  "version": "1.0.0",
  "description": "Ecommerce Backend written in Nodejs",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch ./src/server.ts",
    "build": "tsc --build",
    "start": "cross-env NODE_ENV=production node ./dist/server.js",
    "format:write": "prettier --write .",
    "format:check": "prettier ."
  },
  "keywords": [
    "nodejs",
    "ecommerce"
  ],
  "author": "luutanhung",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1"
  }
}
