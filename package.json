{
  "name": "ecommerce-backend-nodejs",
  "version": "1.0.0",
  "description": "Ecommerce Backend written in Nodejs",
  "main": "./src/server.js",
  "scripts": {
    "dev:mongodb": "podman-compose up -d",
    "dev": "cross-env NODE_ENV=development tsx --watch ./src/server.ts",
    "copy-locales": "copyfiles -u 1 \"src/locales/**/*\" dist/locales",
    "build": "tsc -p tsconfig.build.json && npm run copy-locales",
    "start": "cross-env NODE_ENV=production node ./dist/server.js",
    "format:check": "prettier .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint \"./src/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"./src/**/*.{js,ts}\"",
    "prepare": "husky",
    "test": "vitest"
  },
  "keywords": [
    "nodejs",
    "ecommerce"
  ],
  "author": "luutanhung",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/i18n": "^0.13.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/mongoose-paginate-v2": "^1.6.4",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "eslint": "^10.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.4",
    "ms": "^2.1.3",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "i18n": "^0.15.3",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.6.2",
    "mongoose-paginate-v2": "^1.9.4",
    "morgan": "^1.10.1",
    "slugify": "^1.6.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  }
}
