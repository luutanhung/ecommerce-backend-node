{
  "name": "ecommerce-backend-nodejs",
  "version": "1.0.0",
  "description": "Ecommerce Backend written in Nodejs",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch ./src/server.ts",
    "build": "tsc --build",
    "start": "cross-env NODE_ENV=production node ./dist/server.js",
    "format:check": "prettier .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint \"./src/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"./src/**/*.{js,ts}\"",
    "prepare": "husky"
  },
  "keywords": [
    "nodejs",
    "ecommerce"
  ],
  "author": "luutanhung",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.4",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  }
}
